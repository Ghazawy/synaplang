// SynapLang Grammar Specification for Lark

start: module | top_level_list

module: "(" "module" top_level* ")"
top_level_list: top_level*

?top_level: fn_def | struct_def

struct_def: "(" "struct" CNAME (param_list | param)* ")"

fn_def: "(" "fn" CNAME param_list return_type? expr+ ")"

param_list: "(" param* ")"
          | "[" param* "]"

param: CNAME ":" type_name
     | "(" CNAME ":" type_name ")"
     | "[" CNAME ":" type_name "]"
     | CNAME type_name

return_type: "->" type_name

type_name: "i32"     -> type_i32
         | "f64"     -> type_f64
         | "bool"    -> type_bool
         | "arr_i32" -> type_arr_i32
         | "string"  -> type_string
         | CNAME     -> type_custom

?expr: literal
     | var_ref
     | let_expr
     | set_expr
     | binary_op
     | unary_op
     | if_expr
     | while_expr
     | for_expr
     | block_expr
     | call_expr
     | return_expr
     | arr_new_expr
     | arr_get_expr
     | arr_set_expr
     | arr_len_expr
     | arr_lit_expr
     | struct_new_expr
     | struct_get_expr
     | struct_set_expr
     | print_str_expr
     | println_str_expr
     | print_i32_expr
     | print_f64_expr
     | str_len_expr
     | str_concat_expr

literal: SIGNED_FLOAT   -> float_lit
       | SIGNED_INT     -> int_lit
       | "true"         -> bool_true
       | "false"        -> bool_false
       | ESCAPED_STRING -> string_lit

var_ref: CNAME

let_expr: "(" "let" CNAME ":" type_name expr ")"
        | "(" "let" CNAME type_name expr ")"
        | "(" "let" "(" CNAME ":" type_name ")" expr ")"
        | "(" "let" CNAME expr ")"
        | "(" ":=" CNAME expr ")"

set_expr: "(" "set" CNAME expr ")"

binary_op: "(" bin_op expr expr ")"

!bin_op: "+" | "-" | "*" | "/" | "%"
       | "==" | "!=" | "<=" | ">=" | "<" | ">"
       | "and" | "or"

unary_op: "(" UNARY_OP expr ")"

UNARY_OP: "not" | "neg"

if_expr: "(" "if" expr expr expr? ")"

while_expr: "(" "while" expr expr+ ")"

for_expr: "(" "for" CNAME expr expr expr+ ")"

block_expr: "(" "do" expr+ ")"
          | "(" "block" expr+ ")"

call_expr: "(" "call" CNAME expr* ")"
         | "(" CNAME expr* ")"

return_expr: "(" "return" expr ")"

arr_new_expr: "(" "arr_new" expr ")"
arr_get_expr: "(" "arr_get" expr expr ")"
            | "(" "@" expr expr ")"
arr_set_expr: "(" "arr_set" expr expr expr ")"
            | "(" "@=" expr expr expr ")"
arr_len_expr: "(" "arr_len" expr ")"
            | "(" "#" expr ")"
            | "(" "len" expr ")"
arr_lit_expr: "(" "array" expr* ")"
            | "[" expr* "]"

struct_new_expr: "(" "struct_new" CNAME expr* ")"
               | "(" "new" CNAME expr* ")"
struct_get_expr: "(" "struct_get" expr CNAME ")"
               | "(" "." expr CNAME ")"
               | "(" "get" expr CNAME ")"
struct_set_expr: "(" "struct_set" expr CNAME expr ")"

print_str_expr: "(" "print" expr ")"
println_str_expr: "(" "println" expr ")"
print_i32_expr: "(" "print_i32" expr ")"
print_f64_expr: "(" "print_f64" expr ")"
str_len_expr: "(" "str_len" expr ")"
str_concat_expr: "(" "str_concat" expr expr ")"

COMMENT: /;[^\n]*/
%ignore COMMENT

%import common.CNAME
%import common.SIGNED_INT
%import common.SIGNED_FLOAT
%import common.ESCAPED_STRING
%import common.WS
%ignore WS
